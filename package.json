{
  "name": "eduguide-ai",
  "version": "1.0.0",
  "description": "EduGuide AI – dual-environment monorepo (localhost + Vercel)",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --prefix server & npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "postinstall": "npm install --prefix client && npm install --prefix server",
    "build": "npm run build --prefix client",
    "vercel-build": "npm install --prefix client && npm install --prefix server && npm run build --prefix client",
    "install:all": "npm install --prefix client && npm install --prefix server"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@google/genai": "^1.52.0",
    "@supabase/supabase-js": "^2.110.0",
    "axios": "^1.16.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  }
}

