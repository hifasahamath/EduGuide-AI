# ==============================================================================
# EduGuide AI — Environment Variables Template
# Copy this file to .env and fill in your real credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# In local development: http://localhost:5000/api
# In production (Vercel): /api
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE & AUTHENTICATION)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only Secret Key (Bypasses Row Level Security for admin & backend operations)
# NEVER expose this key to the frontend client!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. AI / LLM PROVIDER API KEYS (RAG & Chat Generation)
# ------------------------------------------------------------------------------
# Google Gemini (Primary for Embeddings & Default Chat)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Optional — for GPT-4o / GPT-3.5)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Optional — for Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI / Grok (Optional)
XAI_API_KEY=your_xai_api_key_here

# ------------------------------------------------------------------------------
# 4. BACKEND SERVER CONFIGURATION & SECURITY
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Allowed CORS origins (comma-separated). Set to your Vercel frontend URL or *
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
